            if (mutatVillamot) {
              long jelenlegiIdo = System.currentTimeMillis();
              if (jelenlegiIdo - utolsoBookSebzes2 >= 2000) {
                playerHP -= 5;
                if (playerHP <= 0) {
                  playerHP = 0;
                  isRunning = false;
                }
                utolsoBookSebzes2 = jelenlegiIdo;
              }
            }
          }

          //Processzor kímélése
          try {
            Thread.sleep(50);
          } catch (InterruptedException e) {
            e.printStackTrace();
          }
        }

        kepernyo.stopScreen();

