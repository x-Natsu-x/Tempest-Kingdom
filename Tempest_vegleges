  public static void buy(Screen screen, TextGraphics tg) throws IOException, InterruptedException {
    KeyStroke gombnyomas = null;
    String[] sziv = { " .-. .-. ", "(   X   )", " \\     / ", "  \\   /  ", "   `-'   " };
    String[] kard = { "   |   ", "   |   ", "   |   ", " --|-- ", "   o   " };

    while (true) {
      screen.clear();

      for (int i = 0; i < sziv.length; i++) tg.putString(50, 25 + i, sziv[i]);
      tg.putString(50, 32, "nyomj 'H' 50 gold (+5 HP)");

      for (int i = 0; i < kard.length; i++) tg.putString(110, 25 + i, kard[i]);
      tg.putString(110, 32, "nyomj 'D' 100 gold (Kard+ )");

      tg.putString(25, 9, "Goldod szama: " + p_gold + "   ");
      screen.refresh();

      gombnyomas = screen.readInput();
      if (gombnyomas != null && gombnyomas.getKeyType() == KeyType.Escape) {
        break;
      }

      if (gombnyomas != null && gombnyomas.getKeyType() == KeyType.Character) {
        char betu = Character.toLowerCase(gombnyomas.getCharacter());
        switch (betu) {
          case 'h':
            if (p_gold >= 50) {
              p_hp += 5;
              p_gold -= 50;
              adatokMentese(ut); // Mentés a fájlba
              tg.putString(50, 35, "Sikeresen kaptal 5 eleterot!");
              screen.refresh();
              Thread.sleep(1000);
            } else {
              tg.putString(50, 35, "Nincs eleg goldod!");
              screen.refresh();
              Thread.sleep(1000);
            }
            break;

          case 'd':
            if (p_gold >= 100) {
              if (p_weapon.equals("long sword")) {
                tg.putString(110, 35, "Mar a legjobb fegyvered van!");
                screen.refresh();
                Thread.sleep(1000);
              } else {
                if (p_weapon.equals("fist")) p_weapon = "wooden sword";
                else if (p_weapon.equals("wooden sword")) p_weapon = "long sword";

                p_gold -= 100;
                p_dmg = weapon_Dmg_Kiszamol(ut, p_weapon);
                adatokMentese(ut); // Mentés a fájlba
                tg.putString(110, 35, "A fegyvered '" + p_weapon + "' lett!");
                screen.refresh();
                Thread.sleep(1000);
              }
            } else {
              tg.putString(110, 35, "Nincs eleg goldod!");
              screen.refresh();
              Thread.sleep(1000);
            }
            break;
        }
      }
    }
  }



