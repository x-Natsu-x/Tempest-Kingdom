  public static String kiiratas(String szo) {
    String[] tomb = szo.split("");
    ArrayList<String> Tomb = new ArrayList<>(Arrays.asList(tomb));
    int szamlalo = 0;
    for (String i : Tomb) {
      if (i.equals(".")) szamlalo++;
    }
    if (szamlalo >= 2) {
      int index = 0;
      for (int i = 0; i < Tomb.size(); i++) {
        if (Tomb.get(i).equals(".")) { index = i; break; }
      }
      Tomb.set(index, "[");
      Tomb.set((index + 1), "]");
      StringBuilder uj_Szo = new StringBuilder();
      for (String i : Tomb) uj_Szo.append(i);
      return uj_Szo.toString();
    } else {
      return szo;
    }
  }


