  // Adatok beolvasása a fájlból a játék legelején (CSAK EGYSZER FUT LE)
  public static void adatokBetoltese(String file_Path) {
    try {
      RandomAccessFile adatok = new RandomAccessFile(file_Path, "r");
      String sor;
      while ((sor = adatok.readLine()) != null) {
        if (sor.contains("=")) {
          String[] parts = sor.split("=");
          String kulcs = parts[0].trim();
          String ertek = parts[1].trim();

          if (kulcs.equals("charakter_hp")) p_hp = Integer.parseInt(ertek);
          else if (kulcs.equals("equipped_Weapon")) p_weapon = ertek;
          else if (kulcs.equals("gold_mennyiseg")) p_gold = Integer.parseInt(ertek);
        }
      }
      adatok.close();

      // Sebzés kiszámítása a betöltött fegyver alapján
      p_dmg = weapon_Dmg_Kiszamol(file_Path, p_weapon);
    } catch (IOException e) {
      System.out.println("Hiba a betöltéskor: " + e.getMessage());
    }
  }

  public static int weapon_Dmg_Kiszamol(String file_Path, String fegyverNev) {
    try {
      RandomAccessFile adatok = new RandomAccessFile(file_Path, "r");
      String sor;
      while ((sor = adatok.readLine()) != null) {
        if (sor.contains("=")) {
          String[] parts = sor.split("=");
          if (parts[0].trim().equals(fegyverNev)) {
            adatok.close();
            return Integer.parseInt(parts[1].trim());
          }
        }
      }
      adatok.close();
    } catch (IOException e) {
      // Alapértelmezett értékek, ha nem találná a fájlban
    }
    if (fegyverNev.equals("wooden sword")) return 25;
    if (fegyverNev.equals("long sword")) return 50;
    return 10;
  }

  // Fájl mentése változások után
  public static void adatokMentese(String file_Path) {
    try {
      RandomAccessFile adatok = new RandomAccessFile(file_Path, "rw");
      adatok.seek(0);
      adatok.setLength(0);
      adatok.writeBytes("fist = 10\n");
      adatok.writeBytes("wooden sword = 25\n");
      adatok.writeBytes("long sword = 50\n");
      adatok.writeBytes("equipped_Weapon = " + p_weapon + "\n");
      adatok.writeBytes("charakter_hp = " + p_hp + "\n");
      adatok.writeBytes("equipped_Armor = nincs\n");
      adatok.writeBytes("gold_mennyiseg = " + p_gold + "\n");
      adatok.close();
    } catch (IOException e) {
      System.out.println("Sikertelen mentés!");
    }
  }

