import com.googlecode.lanterna.TerminalPosition;
import com.googlecode.lanterna.TextColor;
import com.googlecode.lanterna.graphics.TextGraphics;
import com.googlecode.lanterna.input.KeyStroke;
import com.googlecode.lanterna.input.KeyType;
import com.googlecode.lanterna.screen.Screen;
import com.googlecode.lanterna.screen.TerminalScreen;
import com.googlecode.lanterna.terminal.DefaultTerminalFactory;
import com.googlecode.lanterna.terminal.Terminal;
import com.googlecode.lanterna.TerminalSize;

import java.io.IOException;

public class Main {
    public static void main(String[] args) {

        try {

            //Méret
            DefaultTerminalFactory factory = new DefaultTerminalFactory();
            factory.setInitialTerminalSize(new TerminalSize(180, 50));

            //Terminál
            Terminal ablak = factory.createTerminalEmulator();
            Screen kepernyo = new TerminalScreen(ablak);
            kepernyo.startScreen();
            kepernyo.setCursorPosition(null);

            //Kezdőpont
            int playerX = 10;
            int playerY = 10;
            boolean isRunning = true;

            //Player
            String karakter = "(<*-*)<";

            while (isRunning) {
                kepernyo.clear();

                //szin
                TextGraphics textGraphics = kepernyo.newTextGraphics();
                textGraphics.setForegroundColor(TextColor.ANSI.MAGENTA_BRIGHT);

                //karakter kiírása
                textGraphics.putString(new TerminalPosition(playerX, playerY), karakter);

                kepernyo.refresh();

                //Karakter mozgÁs
                KeyStroke gombnyomas = kepernyo.readInput();
                if (gombnyomas != null) {
                    if (gombnyomas.getKeyType() == KeyType.Escape) {
                        isRunning = false;
                    } else if (gombnyomas.getKeyType() == KeyType.Character) {
                        char betu = Character.toLowerCase(gombnyomas.getCharacter());

                        switch (betu) {
                            case 'w':
                                playerY--;
                                break;
                            case 's':
                                playerY++;
                                break;
                            case 'a':
                                playerX--;
                                break;
                            case 'd':
                                playerX++;
                                break;
                        }
                    }
                }

            }


            kepernyo.stopScreen();

        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
