    public static String equipped_Weapon(String file_Path) {
        String weapon = "";
        try {
            RandomAccessFile Adatok = new RandomAccessFile(file_Path,"r");
            String sor;
            while ((sor=Adatok.readLine()) != null) {
                String[] parts = sor.split("=");
                if (parts.length >= 2) {
                    if (parts[0].trim().equals("equipped_Weapon")) {
                        weapon = parts[1].trim();
                    }
                }
            }
            Adatok.close();

        } catch (IOException e) {
            System.out.println("Hiba "+e.getMessage());
        }
        return weapon;
    }

