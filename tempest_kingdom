import java.io.IOException;
import java.io.RandomAccessFile;
import java.util.RandomAccess;

public class Main {
    public static void main(String[] args) {
        RandomAccessFile Adatok;

        try {
            Adatok = new RandomAccessFile("adatok_tarolasa.txt", "r");

            String sor;
            String Sajat_Fegyver = "";
            while ((sor = Adatok.readLine()) != null) {
                if (sor.startsWith("Birtok_Fegyver")) {
                    Sajat_Fegyver = sor.split("=")[1].trim();
                    break;
                }
            }
            String Fegyver_Sebzés = "";
            if (!Sajat_Fegyver.isEmpty()) {
                Adatok.seek(0);
                while ((sor = Adatok.readLine()) != null) {
                    if (sor.startsWith(Sajat_Fegyver)) {
                        Fegyver_Sebzés = sor.split("=")[1].trim();
                        System.out.println("Ennyit sebez a fegyvered: "+Fegyver_Sebzés);
                        break;
                    }
                }
            }


        } catch (Exception e) {
            System.out.println("Valami nem jó "+e.getMessage());
        }
    }
}

