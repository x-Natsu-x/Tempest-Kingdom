import com.googlecode.lanterna.TerminalPosition;
import com.googlecode.lanterna.TextColor;
import com.googlecode.lanterna.graphics.TextGraphics;
import com.googlecode.lanterna.input.KeyStroke;
import com.googlecode.lanterna.input.KeyType;
import com.googlecode.lanterna.screen.Screen;
import com.googlecode.lanterna.screen.TerminalScreen;
import com.googlecode.lanterna.terminal.DefaultTerminalFactory;
import com.googlecode.lanterna.terminal.Terminal;
import com.googlecode.lanterna.TerminalSize;

import java.io.IOException;

public class Boss_Arena_1 {
    public static void main(String[] args) {

        try {
            //Terminál
            DefaultTerminalFactory factory = new DefaultTerminalFactory();
            factory.setInitialTerminalSize(new TerminalSize(180, 50));
            Terminal ablak = factory.createTerminalEmulator();
            Screen kepernyo = new TerminalScreen(ablak);
            kepernyo.startScreen();
            kepernyo.setCursorPosition(null);


            //Karakter adatai
            int playerX = 90;
            int playerY = 35;
            String karakter = "(<*-*)<";
            int playerHP = 100;
            boolean isRunning = true;


            //Boss adatai
            int bossHP = 100;
            boolean bossHalott = false;
            int bossX = 85;
            int bossY = 20;
            String kopet = "( )";
            int kopetX = 90;
            int kopetY = 21;
            String[] shroomBoss = {
                    "    .......    ",
                    "  .'   o   '.  ",
                    " / o       o \\ ",
                    "|_____________|",
                    "    | O_O |    ",
                    "    |_____|    "
            };
            long kopetekKozottiIdo = 0;
            boolean kopetEl = true;
            long kopetKopese = 0;
            long utolsoGombaSebzes = 0;
            long utolsoKisGombaSebzes = 0;


            //Arena határai
            int arenaBal = 41;
            int arenaJobb = 137;
            int arenaFent = 11;
            int arenaLent = 38;

            //Boss határai
            int bossBal = bossX;
            int bossJobb = bossX + 14;
            int bossFent = bossY;
            int bossLent = bossY + 5;

            //kisGomba generálása
            int kisGombaX = 0;
            int kisGombaY = 0;
            boolean spawnolhat = false;
            int kisBal = 0, kisJobb = 0, kisFent = 0, kisLent = 0;

            while (!spawnolhat) {
                kisGombaX = arenaBal + (int)(Math.random() * (arenaJobb - arenaBal));
                kisGombaY = arenaFent + (int)(Math.random() * (arenaLent - arenaFent));

                kisBal = kisGombaX;
                kisJobb = kisGombaX + 2;
                kisFent = kisGombaY;
                kisLent = kisGombaY + 1;

                boolean utkozikBossal = kisJobb >= bossBal && kisBal <= bossJobb && kisLent >= bossFent && kisFent <= bossLent;
                if (!utkozikBossal) {
                    spawnolhat = true;
                }
            }
            long utolsoGombaTeleportalasIdeje = System.currentTimeMillis();



            //Fő ciklus
            while (isRunning) {
                kepernyo.clear();
                TextGraphics rajzolo = kepernyo.newTextGraphics();


                //Aréna és Folyosó rajzolása
                rajzolo.setForegroundColor(TextColor.ANSI.WHITE);
                rajzolo.drawLine(new TerminalPosition(40,10), new TerminalPosition(140, 10), '█'); //Teteje
                rajzolo.drawLine(new TerminalPosition(40, 10), new TerminalPosition(40, 40), '█');  //Bal oldala
                rajzolo.drawLine(new TerminalPosition(140, 10), new TerminalPosition(140, 40), '█'); //Jobb oldala

                if (!bossHalott) {
                    //Zárt alj
                    rajzolo.drawLine(new TerminalPosition(40, 40), new TerminalPosition(140, 40), '█');
                } else {
                    //Kinyílt alj
                    rajzolo.drawLine(new TerminalPosition(40, 40), new TerminalPosition(84, 40), '█'); //Bal alsó fal
                    rajzolo.drawLine(new TerminalPosition(100, 40), new TerminalPosition(140, 40), '█'); //Jobb alsó fal

                    //Folyosó falai lefelé
                    rajzolo.drawLine(new TerminalPosition(84, 41), new TerminalPosition(84, 49), '█'); //Folyosó bal fala
                    rajzolo.drawLine(new TerminalPosition(100, 41), new TerminalPosition(100, 49), '█'); //Folyosó jobb fala
                }


                if (!bossHalott) {
                    // Boss
                    rajzolo.setForegroundColor(TextColor.ANSI.GREEN);
                    for (int i = 0; i < shroomBoss.length; i++) {
                        rajzolo.putString(new TerminalPosition(bossX, bossY + i), shroomBoss[i]);
                    }

                    //kisGomba teleportálása és rajzolása
                    long jelenlegiIdo = System.currentTimeMillis();
                    if (jelenlegiIdo - utolsoGombaTeleportalasIdeje >= 4500) {
                        boolean ujHelyMegvan = false;
                        while (!ujHelyMegvan) {
                            kisGombaX = arenaBal + (int)(Math.random() * (arenaJobb - arenaBal));
                            kisGombaY = arenaFent + (int)(Math.random() * (arenaLent - arenaFent));

                            kisBal = kisGombaX; kisJobb = kisGombaX + 2;
                            kisFent = kisGombaY; kisLent = kisGombaY + 1;

                            boolean utkozikBossal = kisJobb >= bossBal && kisBal <= bossJobb && kisLent >= bossFent && kisFent <= bossLent;
                            if (!utkozikBossal) {
                                ujHelyMegvan = true;
                            }
                        }
                        utolsoGombaTeleportalasIdeje = jelenlegiIdo;
                    }
                    rajzolo.setForegroundColor(TextColor.ANSI.GREEN_BRIGHT);
                    rajzolo.putString(new TerminalPosition(kisGombaX, kisGombaY), "███");
                    rajzolo.putString(new TerminalPosition(kisGombaX, kisGombaY + 1), "███");

                    if (kopetEl) {
                        rajzolo.setForegroundColor(TextColor.ANSI.BLUE_BRIGHT);
                        if (jelenlegiIdo - kopetekKozottiIdo > 300) {
                            rajzolo.putString(new TerminalPosition(kopetX, kopetY), kopet);
                            if (jelenlegiIdo - kopetKopese >= 100) {
                                kopetY++;

                                kopetKopese = jelenlegiIdo;
                                kopetekKozottiIdo = jelenlegiIdo;
                            }
                            if (kopetY > 49) {
                                kopetEl = false;
                            }
                        }
                    }
                }
                //Boss HP kiírása
                rajzolo.setForegroundColor(TextColor.ANSI.RED);
                rajzolo.putString(new TerminalPosition(120, 8), "Boss: " + bossHP + " HP");

                //Player és HP rajzolása
                rajzolo.setForegroundColor(TextColor.ANSI.GREEN);
                rajzolo.putString(new TerminalPosition(40, 8), "Élet: " + playerHP + " HP");
                rajzolo.setForegroundColor(TextColor.ANSI.MAGENTA_BRIGHT);
                rajzolo.putString(new TerminalPosition(playerX, playerY), karakter);

                kepernyo.refresh();

                // 3. Mozgás
                KeyStroke gombnyomas = kepernyo.pollInput();
                KeyStroke utolsoGomb = null;

                while (gombnyomas != null) {
                    utolsoGomb = gombnyomas;
                    gombnyomas = kepernyo.pollInput();
                }

                if (utolsoGomb != null) {
                    if (utolsoGomb.getKeyType() == KeyType.Escape) {
                        isRunning = false;
                    } else if (utolsoGomb.getKeyType() == KeyType.Character) {
                        char betu = Character.toLowerCase(utolsoGomb.getCharacter());
                        switch (betu) {
                            case 'w':
                                if (playerY > 11) playerY--;
                                break;
                            case 's':
                                if (!bossHalott) {
                                    // Zárt aréna
                                    if (playerY < 39) playerY++;
                                } else {
                                    // Ha a kapu nyitva van
                                    if (playerX >= 85 && playerX <= 93) {
                                        // A folyosón mehetünk teljesen le
                                        if (playerY < 49) playerY++;
                                    } else {
                                        // Nem a kapuban állunk
                                        if (playerY < 39) playerY++;
                                    }
                                }
                                break;
                            case 'a':
                                if (playerY < 40) {
                                    // Arénában
                                    if (playerX > 41) playerX--;
                                } else {
                                    // Folyosón
                                    if (playerX > 85) playerX--;
                                }
                                karakter = ">(*-*>)";
                                break;
                            case 'd':
                                if (playerY < 40) {
                                    // Arénában
                                    if (playerX < 133) playerX++;
                                } else {
                                    // Folyosón
                                    if (playerX < 93) playerX++;
                                }
                                karakter = "(<*-*)<";
                                break;
                        }
                    }
                }

                // 4. Ütközés vizsgálata (Csak ha a Boss él)
                if (!bossHalott) {
                    int jatekosBal = playerX;
                    int jatekosJobb = playerX + 6;
                    int jatekosFent = playerY;
                    int jatekosLent = playerY;

                    // Boss kamikaze sebzés
                    if (jatekosJobb >= bossBal && jatekosBal <= bossJobb && jatekosLent >= bossFent && jatekosFent <= bossLent) {
                        long jelenlegiIdo = System.currentTimeMillis();
                        if (jelenlegiIdo - utolsoGombaSebzes >= 1500) {

                            playerHP -= 5;
                            bossHP -= 20; // Te is sebzed a Boss-t!

                            if (playerHP < 0) playerHP = 0;

                            if (bossHP <= 0) {
                                bossHP = 0;
                                bossHalott = true; // Meghalt, kinyílik a kapu!
                            }

                            utolsoGombaSebzes = jelenlegiIdo;
                        }
                    }

                    // Kis gomba sebzés
                    if (jatekosJobb >= kisBal && jatekosBal <= kisJobb && jatekosLent >= kisFent && jatekosFent <= kisLent) {
                        long jelenlegiIdo = System.currentTimeMillis();
                        if (jelenlegiIdo - utolsoKisGombaSebzes >= 2000) {
                            playerHP -= 5;
                            if (playerHP < 0) playerHP = 0;
                            utolsoKisGombaSebzes = jelenlegiIdo;
                        }
                    }
                }

                try {
                    Thread.sleep(50);
                } catch (InterruptedException e) {
                    e.printStackTrace();
                }
            }

            kepernyo.stopScreen();

        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
