import com.googlecode.lanterna.TerminalPosition;
import com.googlecode.lanterna.TextColor;
import com.googlecode.lanterna.graphics.TextGraphics;
import com.googlecode.lanterna.input.KeyStroke;
import com.googlecode.lanterna.input.KeyType;
import com.googlecode.lanterna.screen.Screen;
import com.googlecode.lanterna.screen.TerminalScreen;
import com.googlecode.lanterna.terminal.DefaultTerminalFactory;
import com.googlecode.lanterna.terminal.Terminal;
import com.googlecode.lanterna.TerminalSize;

import java.io.IOException;

public class Boss_Arena_2 {

    public static void main(String[] args) {
        boolean gyozelem = startBossFight();
    }

    public static boolean startBossFight() {
        boolean nyertel = false;

        try {
            
            //Terminál
            DefaultTerminalFactory factory = new DefaultTerminalFactory();
            factory.setInitialTerminalSize(new TerminalSize(180, 50));
            Terminal ablak = factory.createTerminalEmulator();
            Screen kepernyo = new TerminalScreen(ablak);
            kepernyo.startScreen();
            kepernyo.setCursorPosition(null);


            //Karakter adatai
            int playerHP = 100;
            int playerX = 88;
            int playerY = 35;
            String player = "(<*-*)<";
            boolean isRunning = true;


            //Boss adatai
            int bossHP = 100;
            int bossX = 81;
            int bossY = 19;
            String[] wizadBoss = {
                    "        /^\\        ",
                    "       /_*_\\       ",
                    "   ___/_____\\___   ",
                    "      ( -_- )      ",
                    "     /|\\_=_/|\\     ",
                    "    /||: * :||\\    ",
                    "   / ||: * :|| \\   ",
                    "  |__||:___:||__|  ",
                    "       _| |_       "
            };
            long utolsoWizardSebzes = 0;
            boolean bossHalott = false;

            //Boss lövedék adatai
            boolean lovedekAktiv = false;
            int lovedekX = 0;
            int lovedekY = 0;
            int lovedekIrany = 0;
            long utolsoLovedekIdo = 0;


            //Könyvek adatai
            int book1X = 68;
            int book1Y = 22;
            int book2X = 105;
            int book2Y = 22;
            String[] wizardBook = {
                    "[====]",
                    " ~~~~ "
            };
            String[] wizardCrystalLightning = {
                    "  ϟ      ϟ  ",
                    "   ϟ    ϟ   ",
                    " ϟ        ϟ ",
                    "            "
            };
            long utolsoBookSebzes2 = 0;
            long konyvbeLepesIdeje = 0;
            boolean elozoKonyvbenVan = false;

            //Támadás
            long utolsoFTamadas = 0;


            //Fő ciklus
            while (isRunning) {
                kepernyo.clear();
                TextGraphics rajzolo = kepernyo.newTextGraphics();

                //Player határok
                int playerBal = playerX;
                int playerJobb = playerX + 6;
                int playerFent = playerY;
                int playerLent = playerY;

                //Távolság kiszámítása a Boss-tól (F támadáshoz)
                int gapX = Math.max(0, Math.max(bossX - playerJobb, playerBal - (bossX + 18)));
                int gapY = Math.max(0, Math.max(bossY - playerLent, playerFent - (bossY + 8)));
                boolean kozelVanABosshoz = (gapX <= 2 && gapY <= 2);

                //Aréna
                rajzolo.setForegroundColor(TextColor.ANSI.WHITE);
                rajzolo.drawLine(new TerminalPosition(40, 10), new TerminalPosition(140, 10), '█');//Fent
                rajzolo.drawLine(new TerminalPosition(40, 10), new TerminalPosition(40, 40), '█');//Bal
                rajzolo.drawLine(new TerminalPosition(140, 10), new TerminalPosition(140, 40), '█');
                rajzolo.drawLine(new TerminalPosition(40, 40), new TerminalPosition(140, 40), '█');

                //F Támadás kijelzése
                long jelenlegiIdoKijelzeshez = System.currentTimeMillis();
                long elteltF = jelenlegiIdoKijelzeshez - utolsoFTamadas;

                if (elteltF < 1000) {
                    rajzolo.setForegroundColor(TextColor.ANSI.RED);
                    rajzolo.putString(new TerminalPosition(85, 8), "[ F ]");
                } else if (kozelVanABosshoz) {
                    rajzolo.setForegroundColor(TextColor.ANSI.GREEN_BRIGHT);
                    rajzolo.putString(new TerminalPosition(85, 8), "[ F ]");
                } else {
                    rajzolo.setForegroundColor(TextColor.ANSI.WHITE);
                    rajzolo.putString(new TerminalPosition(85, 8), "F támadás: Túl messze vagy");
                }


                //Boss, lövedék és könyvek kiírása
                boolean mutatVillamot = false;

                if (!bossHalott) {
                    rajzolo.setForegroundColor(TextColor.ANSI.GREEN);
                    for (int i = 0; i < wizadBoss.length; i++) {
                        rajzolo.putString(new TerminalPosition(bossX, bossY + i), wizadBoss[i]);
                    }
                    for (int i = 0; i < wizardBook.length; i++) {
                        rajzolo.putString(new TerminalPosition(book1X, book1Y + 2 + i), wizardBook[i]);
                    }
                    for (int i = 0; i < wizardBook.length; i++) {
                        rajzolo.putString(new TerminalPosition(book2X + 2, book2Y + 2 + i), wizardBook[i]);
                    }
                    rajzolo.setForegroundColor(TextColor.ANSI.RED);
                    rajzolo.putString(new TerminalPosition(120, 8), "Boss élet: " + bossHP + " HP");

                    //Boss lövedék vizsgálata és indítása
                    if (!lovedekAktiv) {
                        if (playerJobb >= bossX && playerBal <= bossX + 18) {
                            if (jelenlegiIdoKijelzeshez - utolsoLovedekIdo > 2000) {
                                lovedekX = bossX + (int)(Math.random() * 19);

                                if (playerY < bossY) {
                                    lovedekY = bossY - 1;
                                    lovedekIrany = -1;
                                    lovedekAktiv = true;
                                    utolsoLovedekIdo = jelenlegiIdoKijelzeshez;
                                } else if (playerY > bossY + 8) {
                                    lovedekY = bossY + 9;
                                    lovedekIrany = 1;
                                    lovedekAktiv = true;
                                    utolsoLovedekIdo = jelenlegiIdoKijelzeshez;
                                }
                            }
                        }
                    }

                    //Lövedék mozgatása és rajzolása
                    if (lovedekAktiv) {
                        lovedekY += lovedekIrany;

                        if (lovedekY <= 10 || lovedekY >= 40) {
                            lovedekAktiv = false;
                        } else {
                            rajzolo.setForegroundColor(TextColor.ANSI.YELLOW_BRIGHT);
                            rajzolo.putString(new TerminalPosition(lovedekX, lovedekY), "o");

                            if (lovedekY == playerY && lovedekX >= playerBal && lovedekX <= playerJobb) {
                                playerHP -= 10;
                                if (playerHP <= 0) {
                                    playerHP = 0;
                                    isRunning = false;
                                }
                                lovedekAktiv = false;
                            }
                        }
                    }

                    //Könyvek határai
                    int book1Bal = book1X;
                    int book1Jobb = book1X + 5;
                    int book1Fent = book1Y + 2;
                    int book1Lent = book1Y + 3;

                    int book2Bal = book2X + 2;
                    int book2Jobb = book2X + 7;
                    int book2Fent = book2Y + 2;
                    int book2Lent = book2Y + 3;

                    boolean konyvbenVan1 = (playerBal <= book1Jobb && playerJobb >= book1Bal && playerFent <= book1Lent && playerLent >= book1Fent);
                    boolean konyvbenVan2 = (playerBal <= book2Jobb && playerJobb >= book2Bal && playerFent <= book2Lent && playerLent >= book2Fent);
                    boolean mostKonyvbenVan = konyvbenVan1 || konyvbenVan2;

                    if (mostKonyvbenVan && !elozoKonyvbenVan) {
                        konyvbeLepesIdeje = System.currentTimeMillis();
                        elozoKonyvbenVan = true;
                    } else if (!mostKonyvbenVan) {
                        elozoKonyvbenVan = false;
                    }

                    mutatVillamot = mostKonyvbenVan && (System.currentTimeMillis() - konyvbeLepesIdeje >= 1500);

                    if (mutatVillamot) {
                        rajzolo.setForegroundColor(TextColor.ANSI.CYAN);
                        for (int i = 0; i < wizardCrystalLightning.length; i++) {
                            rajzolo.putString(new TerminalPosition(book1X - 3, book1Y - 2 + i), wizardCrystalLightning[i]);
                            rajzolo.putString(new TerminalPosition(book2X - 1, book2Y - 2 + i), wizardCrystalLightning[i]);
                        }
                    }
                }

                //Player kiírása
                rajzolo.setForegroundColor(TextColor.ANSI.MAGENTA_BRIGHT);
                rajzolo.putString(new TerminalPosition(playerX, playerY), player);

                rajzolo.setForegroundColor(TextColor.ANSI.GREEN_BRIGHT);
                rajzolo.putString(new TerminalPosition(40, 8), "Élet: " + playerHP + " HP");

                kepernyo.refresh();

                //Mozgás és input
                KeyStroke gombnyomas = kepernyo.pollInput();
                KeyStroke utolsoGomb = null;
                while (gombnyomas != null) {
                    utolsoGomb = gombnyomas;
                    gombnyomas = kepernyo.pollInput();
                }
                if (utolsoGomb != null) {
                    if (utolsoGomb.getKeyType() == KeyType.Escape) {
                        isRunning = false;
                    } else if (utolsoGomb.getKeyType() == KeyType.Character) {
                        char betu = Character.toLowerCase(utolsoGomb.getCharacter());
                        switch (betu) {
                            case 'w':
                                if (playerY > 11) {
                                    playerY--;
                                }
                                break;
                            case 's':
                                if (playerY < 37) {
                                    playerY++;
                                }
                                break;
                            case 'a':
                                player = ">(*-*>)";
                                if (playerX > 41) {
                                    playerX--;
                                }
                                break;
                            case 'd':
                                player = "(<*-*)<";
                                if (playerX < 133) {
                                    playerX++;
                                }
                                break;
                            case 'f':
                                if (kozelVanABosshoz) {
                                    long jelenlegiI = System.currentTimeMillis();
                                    if (jelenlegiI - utolsoFTamadas >= 1000) {
                                        bossHP -= 10;
                                        utolsoFTamadas = jelenlegiI;
                                        if (bossHP <= 0) {
                                            bossHP = 0;
                                            bossHalott = true;
                                            nyertel = true;
                                            isRunning = false;
                                        }
                                    }
                                }
                                break;
                        }
                    }
                }

                //Ütközés vizsgálata
                if (!bossHalott && isRunning) {
                    //Boss ütközés
                    int bossBal = bossX;
                    int bossJobb = bossX + 18;
                    int bossFent = bossY;
                    int bossLent = bossY + 8;

                    if (playerBal <= bossJobb && playerJobb >= bossBal && playerFent <= bossLent && playerLent >= bossFent) {
                        long jelenlegiIdo = System.currentTimeMillis();
                        if (jelenlegiIdo - utolsoWizardSebzes >= 1500) {
                            playerHP -= 5;
                            if (playerHP <= 0) {
                                playerHP = 0;
                                isRunning = false;
                            }
                            utolsoWizardSebzes = jelenlegiIdo;
                        }
                    }

                    //Könyv villám sebzés
                    if (mutatVillamot) {
                        long jelenlegiIdo = System.currentTimeMillis();
                        if (jelenlegiIdo - utolsoBookSebzes2 >= 2000) {
                            playerHP -= 5;
                            if (playerHP <= 0) {
                                playerHP = 0;
                                isRunning = false;
                            }
                            utolsoBookSebzes2 = jelenlegiIdo;
                        }
                    }
                }

                //Processzor kímélése
                try {
                    Thread.sleep(50);
                } catch (InterruptedException e) {
                    e.printStackTrace();
                }
            }

            kepernyo.stopScreen();

        } catch (IOException e) {
            e.printStackTrace();
        }

        return nyertel;
    }
}
